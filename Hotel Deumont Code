MatchChecker

using UnityEngine;
using UnityEngine.UI;

public class MatchChecker : MonoBehaviour
{
    public void CheckMatch(Tile tile)
    {
        Tile[,] board = BoardManager.Instance.boardTiles;

        // HORIZONTAL MATCHES
        for (int y = 0; y < BoardManager.Instance.height; y++)
        {
            for (int x = 0; x < BoardManager.Instance.width - 2; x++)
            {
                Tile first = board[x, y];
                Tile second = board[x + 1, y];
                Tile third = board[x + 2, y];

                if (first.tileType == second.tileType &&
                    second.tileType == third.tileType)
                {
                    Debug.Log("MATCH FOUND!");

                    ScoreManager.Instance.AddScore(100);

                    RemoveTile(first);
                    RemoveTile(second);
                    RemoveTile(third);
                }
            }
        }

        // VERTICAL MATCHES
        for (int x = 0; x < BoardManager.Instance.width; x++)
        {
            for (int y = 0; y < BoardManager.Instance.height - 2; y++)
            {
                Tile first = board[x, y];
                Tile second = board[x, y + 1];
                Tile third = board[x, y + 2];

                if (first.tileType == second.tileType &&
                    second.tileType == third.tileType)
                {
                    Debug.Log("VERTICAL MATCH FOUND!");

                    ScoreManager.Instance.AddScore(100);

                    RemoveTile(first);
                    RemoveTile(second);
                    RemoveTile(third);
                }
            }
        }
    }

    void RemoveTile(Tile tile)
    {
        Image image = tile.GetComponent<Image>();

        int randomTile =
            Random.Range(
                0,
                BoardManager.Instance.tileSprites.Length);

        tile.tileType = randomTile;

        image.sprite =
            BoardManager.Instance.tileSprites[randomTile];

        image.enabled = true;
    }
}

