EyeTimerManager

using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

public class EyeTimerManager : MonoBehaviour
{
    public Image eyeImage;

    public Sprite eyePhase1;
    public Sprite eyePhase2;
    public Sprite eyePhase3;
    public Sprite eyePhase4;
    public Sprite eyePhase5;

    public float timer = 60f;

    private float maxTime;

    void Start()
    {
        maxTime = timer;
        eyeImage.sprite = eyePhase1;
    }

    void Update()
    {
        timer -= Time.deltaTime;

        float progress = 1f - (timer / maxTime);

        if (progress >= 0.8f)
        {
            eyeImage.sprite = eyePhase5;
        }
        else if (progress >= 0.6f)
        {
            eyeImage.sprite = eyePhase4;
        }
        else if (progress >= 0.4f)
        {
            eyeImage.sprite = eyePhase3;
        }
        else if (progress >= 0.2f)
        {
            eyeImage.sprite = eyePhase2;
        }
        else
        {
            eyeImage.sprite = eyePhase1;
        }

        if (timer <= 0)
        {
            SceneManager.LoadScene("DefeatScene");
        }
    }
}

