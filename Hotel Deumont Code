BoardManager

using UnityEngine;
using UnityEngine.UI;

public class BoardManager : MonoBehaviour
{
    public static BoardManager Instance;

    public GameObject tilePrefab;

    public Sprite[] tileSprites;

    public int width = 8;
    public int height = 7;

    public Tile[,] boardTiles;

    private void Awake()
    {
        Instance = this;
    }

    void Start()
    {
        boardTiles = new Tile[width, height];

        GenerateBoard();
    }

    void GenerateBoard()
    {
        for (int y = 0; y < height; y++)
        {
            for (int x = 0; x < width; x++)
            {
                GameObject tile =
                    Instantiate(tilePrefab, transform);

                Tile tileScript =
                    tile.GetComponent<Tile>();

                tileScript.x = x;
                tileScript.y = y;

                boardTiles[x, y] = tileScript;

                int randomTile =
                    Random.Range(0, tileSprites.Length);

                tileScript.tileType = randomTile;

                Image image =
                    tile.GetComponent<Image>();

                image.sprite =
                    tileSprites[randomTile];
            }
        }
    }
}

